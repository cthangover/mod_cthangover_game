{
  "id": "cthangover_game",
  "name": "Cthangover: Story",
  "version": "0.1.0",
  "author": "ct",
  "description": "The story content of Cthangover: scenes, scenarios, characters, items, quests and the world map of Marao's very bad night. The machinery lives in engine mods.",
  "categories": ["story"],
  "depends": [
    "shell2d_base>=0.1.0",
    "dialog_base>=0.1.0",
    "interactive_base>=0.1.0",
    "skills_base>=0.1.0",
    "map_base>=0.1.0",
    "ui_base>=0.1.0",
    "characters_base>=0.1.0",
    "items_base>=0.1.0",
    "quests_base>=0.1.0",
    "town_pack>=0.1.0",
    "music_pack>=0.1.0"
  ],
  "sources": [
    "src/**/*.cs"
  ],
  "test_suites": [
    {
      "id": "site_shots",
      "activate": [
        "--itest=site_shots"
      ]
    },
    {
      "id": "marao_avatars",
      "activate": [
        "--itest=marao_avatars"
      ]
    }
  ]
}
